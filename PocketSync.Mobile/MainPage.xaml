<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketSync.Mobile.MainPage"
             Title="PocketSync">

    <Grid Padding="16">

        <!-- ============ starea: nepairat ============ -->
        <VerticalStackLayout x:Name="PairPanel" Spacing="12" VerticalOptions="Center" IsVisible="False">
            <Label Text="PocketSync" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="Conectează-te la PC-ul tău:" HorizontalOptions="Center"/>
            <Label Text="1. Deschide PocketSync pe PC (fereastra cu QR)&#10;2. Apasă «Copiază link» pe PC și trimite-ți link-ul&#10;3. Lipește-l aici"
                   FontSize="13" TextColor="Gray"/>
            <Entry x:Name="PairingUrlEntry" Placeholder="http://192.168.x.x:5000/?token=..."/>
            <Button x:Name="PairButton" Text="Conectează" Clicked="Pair_Clicked"/>
            <Label x:Name="PairError" TextColor="Red" IsVisible="False"/>
        </VerticalStackLayout>

        <!-- ============ starea: pairat ============ -->
        <Grid x:Name="MainPanel" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" IsVisible="False">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Ellipse Grid.Column="0" x:Name="StatusDot" WidthRequest="12" HeightRequest="12"
                         Fill="Gray" VerticalOptions="Center"/>
                <Label Grid.Column="1" x:Name="StatusLabel" Text="Se verifică..." VerticalOptions="Center"/>
                <Button Grid.Column="2" Text="⟳" Clicked="Refresh_Clicked" Padding="12,2"/>
            </Grid>

            <Button Grid.Row="1" x:Name="UploadButton" Text="＋ Trimite fișiere pe PC" Clicked="Upload_Clicked"/>

            <VerticalStackLayout Grid.Row="2" Spacing="4">
                <ProgressBar x:Name="UploadProgress" IsVisible="False"/>
                <Label x:Name="UploadStatus" FontSize="13" TextColor="Gray" IsVisible="False"/>
            </VerticalStackLayout>

            <RefreshView Grid.Row="3" x:Name="ListRefresh" Refreshing="ListRefresh_Refreshing">
                <CollectionView x:Name="FilesList" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Niciun fișier în Storage pe PC." TextColor="Gray"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,10" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="File_Tapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Meta}" FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="⬇" FontSize="20" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Button Grid.Row="4" Text="Deconectează" Clicked="Unpair_Clicked"
                    BackgroundColor="Transparent" TextColor="Red" FontSize="13"/>
        </Grid>

    </Grid>
</ContentPage>
