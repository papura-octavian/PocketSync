<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- paleta PocketSync: violet → albastru, din iconul aplicației -->
    <Color x:Key="Accent">#6366F1</Color>
    <Color x:Key="AccentLight">#8B8DF7</Color>
    <Color x:Key="GradientStart">#B46FD0</Color>
    <Color x:Key="GradientEnd">#5B7FE0</Color>

    <Color x:Key="BgLight">#F4F5FA</Color>
    <Color x:Key="BgDark">#0E1015</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#181B23</Color>
    <Color x:Key="FillLight">#EEF0F6</Color>
    <Color x:Key="FillDark">#222631</Color>
    <Color x:Key="BorderLight">#E5E7EF</Color>
    <Color x:Key="BorderDark">#272B36</Color>
    <Color x:Key="TextLight">#14161C</Color>
    <Color x:Key="TextDark">#ECEDF2</Color>
    <Color x:Key="MutedLight">#6B7080</Color>
    <Color x:Key="MutedDark">#969CAA</Color>
    <Color x:Key="AccentSoftLight">#ECEDFE</Color>
    <Color x:Key="AccentSoftDark">#252848</Color>

    <Color x:Key="Ok">#22C55E</Color>
    <Color x:Key="Warn">#F59E0B</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="DangerSoftLight">#FDECEC</Color>
    <Color x:Key="DangerSoftDark">#3A1E22</Color>

    <!-- cheile din template-ul MAUI, folosite de Styles.xaml — aliniate la paleta de mai sus -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="PrimaryDark">#8B8DF7</Color>
    <Color x:Key="PrimaryDarkText">#0E1015</Color>
    <Color x:Key="Secondary">#ECEDFE</Color>
    <Color x:Key="SecondaryDarkText">#8B8DF7</Color>
    <Color x:Key="Tertiary">#4338CA</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#0E1015</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
