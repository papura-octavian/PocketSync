<Application x:Class="PocketSync.TrayApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- OnExplicitShutdown: altfel aplicația moare când ascunzi fereastra
         și rămâne un icon fantomă în tray -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- tema (Light/Dark.xaml) se adaugă din cod, la pornire — ThemeManager -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
