<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- tema light — aceleași nume de chei ca în Dark.xaml; ThemeManager alege una din ele -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F5FA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FillBrush" Color="#EEF0F6"/>
    <SolidColorBrush x:Key="FillHoverBrush" Color="#E3E6EF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#14161C"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7080"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5458E8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECEDFE"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC"/>
    <SolidColorBrush x:Key="OkBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="#E3F8EA"/>
</ResourceDictionary>
