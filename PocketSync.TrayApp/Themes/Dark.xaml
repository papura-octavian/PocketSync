<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- tema dark — aceleași nume de chei ca în Light.xaml; ThemeManager alege una din ele -->
    <SolidColorBrush x:Key="BgBrush" Color="#0E1015"/>
    <SolidColorBrush x:Key="CardBrush" Color="#181B23"/>
    <SolidColorBrush x:Key="FillBrush" Color="#222631"/>
    <SolidColorBrush x:Key="FillHoverBrush" Color="#2B303D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#272B36"/>
    <SolidColorBrush x:Key="TextBrush" Color="#ECEDF2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#969CAA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7477F4"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#9B9DF8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#252848"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1E22"/>
    <SolidColorBrush x:Key="OkBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="#16301F"/>
</ResourceDictionary>
