<Window x:Class="PocketSync.TrayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketSync" Width="940" Height="680"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">

    <Grid Margin="28,22,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= antet ================= -->
        <DockPanel Margin="0,0,0,20">
            <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="13" ClipToBounds="True">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/Logo.png" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="PocketSync" Style="{StaticResource Text}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Fișiere între PC și telefon, direct prin WiFi" Style="{StaticResource Muted}" FontSize="12.5"/>
            </StackPanel>

            <!-- starea serverului -->
            <Border x:Name="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="16" Padding="14,7" Background="{DynamicResource OkSoftBrush}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Margin="8,0,0,0" Text="Activ" FontWeight="SemiBold"
                               Style="{StaticResource Text}" Foreground="{DynamicResource OkBrush}"/>
                    <TextBlock x:Name="StatusAddress" Margin="8,0,0,0" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= stânga: QR de pairing ================= -->
            <Border Style="{StaticResource Card}" Padding="22">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Conectează un telefon" Style="{StaticResource CardTitle}"/>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Muted}"
                                   Text="În aplicația PocketSync de pe telefon apasă „Adaugă un PC” și scanează codul."/>

                        <!-- QR-ul stă mereu pe alb: camera îl citește mai sigur cu contrast mare -->
                        <Border Margin="0,18,0,0" Background="White" CornerRadius="16" Padding="14"
                                HorizontalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Image x:Name="QrImage" Width="216" Height="216" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>

                        <TextBlock Margin="0,16,0,6" Text="Sau trimite-ți link-ul pe telefon:" Style="{StaticResource Muted}"/>
                        <DockPanel>
                            <Button x:Name="CopyLinkButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}" Click="CopyLink_Click" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CopyIcon" Text="&#xE8C8;" Style="{StaticResource Icon}" Foreground="White" FontSize="13"/>
                                    <TextBlock x:Name="CopyText" Text="Copiază" Margin="7,0,0,0" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="UrlText" Style="{StaticResource ReadOnlyBox}" Height="36"/>
                        </DockPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="12,10">
                        <DockPanel>
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top"
                                       Margin="0,1,10,0" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"
                                       Text="Un telefon poate fi legat de mai multe PC-uri. Fiecare PC are codul lui."/>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ================= dreapta ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- acțiuni rapide -->
                <UniformGrid Columns="3">
                    <Button Style="{StaticResource TileButton}" Margin="0,0,6,0" Click="OpenReceived_Click"
                            ToolTip="Fișierele trimise de pe telefon">
                        <StackPanel>
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="Fișiere primite" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Margin="3,0,3,0" Click="OpenStorage_Click"
                            ToolTip="Ce pui aici apare pe telefon, gata de descărcat">
                        <StackPanel>
                            <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="De trimis pe telefon" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Margin="6,0,0,0" Click="OpenPage_Click"
                            ToolTip="Interfața web, aceeași ca pe telefon în browser">
                        <StackPanel>
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="Pagina web" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- transferuri recente -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,18,12,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Primite recent" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <ItemsControl x:Name="RecentList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,5">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                                    <TextBlock Text="{Binding Ext}" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentTextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource Muted}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Size}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel x:Name="RecentEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,8,0">
                                <Border Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource AccentTextBrush}"/>
                                </Border>
                                <TextBlock Text="Nimic primit încă" Margin="0,10,0,2" HorizontalAlignment="Center"
                                           Style="{StaticResource Text}" FontWeight="SemiBold"/>
                                <TextBlock Text="Fișierele trimise de pe telefon apar aici." Style="{StaticResource Muted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- setări -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Setări" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Schimbă" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="PickFolder_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Folder" Style="{StaticResource Text}"/>
                                <TextBlock x:Name="FolderText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>

                        <Separator Margin="0,12" Background="{DynamicResource BorderBrush}"/>

                        <DockPanel>
                            <CheckBox x:Name="AutoStartCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pornește cu Windows" Style="{StaticResource Text}"/>
                                <TextBlock Text="Stă minimizat în tray, gata de primit fișiere" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </DockPanel>

                        <Separator Margin="0,12" Background="{DynamicResource BorderBrush}"/>

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Regenerează" Style="{StaticResource DangerButton}"
                                    Margin="10,0,0,0" Click="RegenerateToken_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Cod de acces" Style="{StaticResource Text}"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Deconectează toate telefoanele legate de acest PC"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
