<Window x:Class="PocketSync.TrayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketSync" Width="420" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">

        <!-- status -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#16a34a" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"
                       Text="Activ" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- QR -->
        <Border BorderBrush="#e4e6eb" BorderThickness="1" CornerRadius="8" Padding="12"
                HorizontalAlignment="Center">
            <StackPanel>
                <Image x:Name="QrImage" Width="220" Height="220"/>
                <TextBlock Text="Scanează cu camera telefonului" Foreground="Gray"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- URL -->
        <DockPanel Margin="0,12,0,0">
            <Button x:Name="CopyLinkButton" DockPanel.Dock="Right" Content="Copiază link"
                    Padding="10,4" Margin="8,0,0,0" Click="CopyLink_Click"/>
            <TextBox x:Name="UrlText" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- acțiuni -->
        <UniformGrid Columns="2" Margin="0,12,0,0">
            <Button Content="Deschide folderul" Margin="0,0,4,0" Padding="0,6" Click="OpenFolder_Click"/>
            <Button Content="Deschide pagina" Margin="4,0,0,0" Padding="0,6" Click="OpenPage_Click"/>
        </UniformGrid>

        <!-- setări -->
        <GroupBox Header="Setări" Margin="0,16,0,0" Padding="8">
            <StackPanel>
                <TextBlock Text="Folder de stocare:" Margin="0,0,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Alege..." Padding="10,2"
                            Margin="8,0,0,0" Click="PickFolder_Click"/>
                    <TextBox x:Name="FolderText" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </DockPanel>

                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Port:" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PortText" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="Gray"/>
                </DockPanel>

                <CheckBox x:Name="AutoStartCheck" Content="Pornește cu Windows (minimizat în tray)"
                          Margin="0,10,0,0" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>

                <Button Content="Regenerează token (deconectează toate device-urile)"
                        Margin="0,12,0,0" Padding="0,6" Click="RegenerateToken_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- transferuri recente -->
        <GroupBox Header="Transferuri recente" Margin="0,12,0,0" Padding="4">
            <ListBox x:Name="RecentList" Height="90" BorderThickness="0"/>
        </GroupBox>

    </StackPanel>
</Window>
